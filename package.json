{
  "name": "@hms/auth",
  "version": "0.2.0",
  "description": "Standard auth client for HMS apps — SSO through the HMS Auth Hub (verifies RS256 tokens via JWKS, manages each app's own session).",
  "license": "UNLICENSED",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./middleware": {
      "types": "./dist/next-middleware.d.ts",
      "default": "./dist/next-middleware.js"
    },
    "./server": {
      "types": "./dist/next-server.d.ts",
      "default": "./dist/next-server.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "jose": "^6.2.3"
  },
  "peerDependencies": {
    "next": ">=15",
    "react": ">=18"
  },
  "devDependencies": {
    "typescript": "^5",
    "@types/node": "^20",
    "@types/react": "^19",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  }
}
